          "jsCode": "const d = $input.first().json;\nconst rules = [];\nconst actions = [];\n\nif (d.pain >= 4) {\n  rules.push('PAIN_ALERT (pain >= 4)');\n  actions.push('STOP exercise and flag case for human supervisor');\n}\nif (d.supervisor_status === 'timeout') {\n  rules.push('SUPERVISOR_TIMEOUT');\n  actions.push('Mark for backup escalation (SIMULATED: supervisor did not respond within ' + d.timeout_minutes + ' min; no real message sent)');\n}\n\nlet rule = 'NONE';\nlet action = 'No rule triggered. Training load unchanged';\nlet reviewed = 'Not required';\nif (rules.length > 0) {\n  rule = rules.join(' + ');\n  action = actions.join(' + ');\n  reviewed = 'No, pending human review';\n}\n\nconst supText = d.supervisor_status === 'available'\n  ? 'available'\n  : 'no response within ' + d.timeout_minutes + ' min (SIMULATED timeout)';\n\nconst reply = [\n  '**Result for ' + d.pseudonymous_id + '**',\n  '- Pain: ' + d.pain + '/10 | Effort: ' + d.effort + '/10',\n  '- Supervisor: ' + supText,\n  '- Rule triggered: ' + rule,\n  '- Action: ' + action,\n  '- Human reviewed: ' + reviewed,\n  '- Audit entry: saved',\n  '',\n  '_DEMO: synthetic data, simulated timeout, no alerts sent. Training load is never raised automatically; no medical or religious rulings are given._',\n].join('\\n');\n\nreturn [{ json: Object.assign({}, d, {\n  logged_at: new Date().toISOString(),\n  rule_triggered: rule,\n  action_taken: action,\n  human_reviewed: reviewed,\n  reply_text: reply,\n}) }];"
        },
