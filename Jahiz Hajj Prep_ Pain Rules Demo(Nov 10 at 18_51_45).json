      "id": "f51c09a2-d978-4922-a4b5-3661cf6118dc",
      "name": "Supervisor Chat Input",
      "type": "@n8n/n8n-nodes-langchain.chatTrigger",
      "typeVersion": 1.5,
      "position": [
        0,
        96
      ],
      "webhookId": "24faf5a9-2b73-42c4-b5d7-9a486163c318"
    },
    {
      "parameters": {
        "jsCode": "const raw = String($input.first().json.chatInput || '');\nconst fields = {};\nraw.split(/[,;]/).forEach((part) => {\n  const i = part.indexOf(':');\n  if (i > 0) {\n    fields[part.slice(0, i).trim().toLowerCase()] = part.slice(i + 1).trim();\n  }\n});\n\nconst errors = [];\nconst id = fields['id'] || '';\nif (!/^[A-Za-z0-9_-]{2,20}$/.test(id)) errors.push('BAD_ID');\n\nconst toScore = (v) => (v !== undefined && /^[0-9]{1,2}$/.test(v) && Number(v) <= 10) ? Number(v) : null;\nconst pain = toScore(fields['pain']);\nif (pain === null) errors.push('BAD_PAIN');\nconst effort = toScore(fields['effort']);\nif (effort === null) errors.push('BAD_EFFORT');\n\nlet status = null;\nlet timeoutMinutes = null;\nconst sup = (fields['supervisor'] || '').toLowerCase().split(' ').filter(Boolean);\nif (sup.length === 1 && sup[0] === 'available') {\n  status = 'available';\n} else if (sup.length === 2 && sup[0] === 'timeout' && /^[0-9]{1,4}$/.test(sup[1]) && Number(sup[1]) > 0) {\n  status = 'timeout';\n  timeoutMinutes = Number(sup[1]);\n} else {\n  errors.push('BAD_SUPERVISOR');\n}\n\nif (errors.length > 0) {\n  const meaning = {\n    BAD_ID: 'pseudonymous ID missing or invalid (2-20 letters, digits, - or _)',\n    BAD_PAIN: 'pain must be a whole number from 0 to 10',\n    BAD_EFFORT: 'effort must be a whole number from 0 to 10',\n    BAD_SUPERVISOR: 'supervisor must be \"available\" or \"timeout <minutes>\"',\n  };\n  const lines = errors.map((e) => '- ' + e + ': ' + meaning[e]);\n  const text = ['**Input rejected. Nothing was processed.**'].concat(lines).concat([\n    '',\n    'Expected format:',\n    'ID: PX-014, pain: 5, effort: 6, supervisor: available',\n    'or: ID: PX-016, pain: 2, effort: 5, supervisor: timeout 15',\n    '',\n    '_DEMO: synthetic data only. The rejected message was not stored._',\n  ]).join('\\n');\n  return [{ json: { valid: false, reason_code: errors.join('|'), error_text: text } }];\n}\n\nreturn [{ json: { valid: true, pseudonymous_id: id, pain, effort, supervisor_status: status, timeout_minutes: timeoutMinutes } }];"
      },
